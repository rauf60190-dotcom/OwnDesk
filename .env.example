# Copy to .env. Never commit the populated file.
DOMAIN=desk.example.com
DEPLOYMENT_MODE=organization
PUBLIC_BASE_URL=https://desk.example.com
ALLOWED_HOSTS=desk.example.com,backend,localhost
CSRF_TRUSTED_ORIGINS=https://desk.example.com
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
ACCOUNT_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
# Use a private S3-compatible bucket. No anonymous bucket policy.
S3_ENDPOINT_URL=https://s3.example.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=service-desk

# Public signup stays disabled until domain, Google and SMTP are configured.
PUBLIC_REGISTRATION_ENABLED=0
LOCAL_EMAIL_PREVIEW=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google redirect URI: https://your-domain/api/v1/auth/google/callback
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=
